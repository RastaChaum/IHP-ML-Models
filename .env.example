# IHP ML Models - Development Environment Configuration

# ============================================================================
# Home Assistant Connection
# ============================================================================

# For production HA instance, use your actual HA URL and a long-lived access token
SUPERVISOR_URL=http://homeassistant.local:8123
SUPERVISOR_TOKEN=your_long_lived_token_here

# For local test instance
# SUPERVISOR_URL=http://localhost:8123
# SUPERVISOR_TOKEN=

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG = Very verbose (recommended for development/troubleshooting)
# INFO = Standard operational logs (default)
# WARNING = Only warnings and errors (production)
LOG_LEVEL=DEBUG

# Directory for log files (must be writable, default: /data/logs)
LOG_DIR=/data/logs

# ============================================================================
# Model Storage
# ============================================================================

# Directory where trained models are persisted
MODEL_PERSISTENCE_PATH=/data/models

# ============================================================================
# API Configuration
# ============================================================================

API_HOST=0.0.0.0
API_PORT=5000

# ============================================================================
# Development / Debugging
# ============================================================================

# Enable VSCode remote debugging (server will wait for debugger to attach)
# Set to "true" only when actively debugging with VSCode
DEBUG_MODE=false

